<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Abhyas holds the same line Deja does: no INTERNET permission, so the process cannot open a
      socket and a student's notes cannot leave the phone even if some dependency tried to send
      them. Anyone can check it on the Play Store listing without trusting a policy document.

      This is not decoration on a study app. The pages people photograph are coursework, tuition
      material and their own handwriting, and plenty of it is copyrighted or simply private.
      Keeping the permission off means there is no server to breach and no account to leak.

      Libraries declare permissions of their own and the manifest merger unions them in, so the
      two entries below strip network access back out no matter what any current or future
      dependency asks for. Never "fix" a merger conflict by dropping these lines - check the
      result in app/build/outputs/logs/manifest-merger-*-report.txt after a build.

      Two consequences that shape the code, both inherited from Deja:
        - OCR uses ML Kit's *bundled* text recogniser. The model ships inside the APK; the
          unbundled build downloads it at runtime and would need network.
        - Card generation runs on-device (data/generate/). A cloud model would write better
          questions, and that trade was made deliberately in favour of the guarantee above.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!--
      Android 13+ notification permission.

      Declaring it does NOT turn anything on. Reminders ship off, nothing is scheduled until the
      user switches them on in Settings, and the permission is requested at that moment rather
      than at first launch - a permission prompt before the user knows what it is for is how apps
      earn a denial they can never come back from.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Photographing a page is how cards get made. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!--
      Importing an existing photo goes through ActivityResultContracts.PickVisualMedia, which
      hands back a single user-chosen image through the system photo picker. That deliberately
      needs no storage permission at all, so Abhyas never asks for access to the gallery.
    -->

    <!--
      Text-to-speech. Android 11+ hides other apps' services unless the manifest says which kind it
      looks for, and without this TextToSpeech binds to nothing and fails silently. It is a query,
      not a permission: Abhyas still cannot reach the network, and only offline voices are used.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--
      enableOnBackInvokedCallback: predictive back. The system animates the swipe and shows where it
      leads before it commits; Android 15+ expects it, and Compose's navigation already handles back
      through OnBackPressedDispatcher, which is what the flag routes the gesture to.

      localeConfig: lets Android 13+ offer the app in Hindi from system settings, independently of
      the phone's own language - a student whose phone is in English can still choose a Hindi app.
    -->
    <application
        android:name=".AbhyasApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abhyas"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Abhyas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Puts the daily reminder back on the user's wall clock after the clock moves under it - a
            flight across time zones, or a DST boundary. The pending job carries a fixed delay, so
            without this it arrives at the old instant rather than the chosen time. Not exported:
            both actions are system broadcasts and nothing else has any business sending them.
        -->
        <receiver
            android:name=".data.reminder.ClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!--
            Hands the crash log to the user's mail app, and nothing else: the paths file exposes the
            one log file, read-only, and only for the duration of the grant on that one email.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_paths" />
        </provider>

    </application>

</manifest>
